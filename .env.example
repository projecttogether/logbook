# Local development. Copy to .env.local; `docker compose -f compose.dev.yaml
# up -d` starts PostgreSQL 18 and a Keycloak with a development realm and test
# users (password: logbook-dev): erika (has access), adam (admin), olga (no
# access).
# Every variable is described in docs/configuration.md.

LOGBOOK_BASE_URL=http://localhost:3000
DATABASE_URL=postgres://logbook:logbook@localhost:55432/logbook
# Any 32+ character string in development; production: openssl rand -base64 32
BETTER_AUTH_SECRET=development-secret-development-secret

# Login with any OpenID Connect provider; here the development Keycloak.
OIDC_ISSUER=http://localhost:8090/realms/logbook
OIDC_CLIENT_ID=logbook
OIDC_CLIENT_SECRET=logbook-dev-client-secret

# Where people, teams, and access come from: "manual" (invite people in
# Logbook) or "keycloak" (members of Keycloak groups). For the manual
# directory, set DIRECTORY=manual and INITIAL_ADMIN_EMAILS=adam@example.test.
DIRECTORY=keycloak
KEYCLOAK_ACCESS_GROUP=/logbook
KEYCLOAK_ADMIN_GROUP=/logbook-admins
KEYCLOAK_TEAMS_GROUP=/teams

# Development and tests only log Slack messages and emails. Production sends
# for real (the default when NODE_ENV=production) once Slack or email is set
# up under Admin › Integrations (or with `npm run cli -- settings apply …`).
NOTIFICATION_TRANSPORT=console

# Production with compose.yaml: new secrets, URLs and sign-in values above,
# no NOTIFICATION_TRANSPORT line (docs/deployment.md), and optionally the
# image to run: latest (default) or sha-<commit>.
# LOGBOOK_IMAGE_TAG=latest
